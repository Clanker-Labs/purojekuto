# Copy to .env. Everything is optional for local use (http://localhost:3000).

# Public address and passkey relying-party id. Required anywhere but localhost:
# a passkey is bound to this hostname, and passkeys need https.
# PUROJEKUTO_PUBLIC_URL=https://purojekuto.example.ts.net
# PUROJEKUTO_RP_ID=purojekuto.example.ts.net

# Timezone and currency for NEW accounts (each user can change theirs in Settings).
# PUROJEKUTO_TIMEZONE=Europe/Paris
# PUROJEKUTO_CURRENCY=EUR

# Anyone can create an account unless this is 0 (the first account always can).
# PUROJEKUTO_ALLOW_SIGNUP=0

# Require `Authorization: Bearer <token>` on /api/* and /api/mcp. Without it,
# programmatic access only works from localhost. Set it once the port is
# reachable from a network, or for agents running in containers.
# PUROJEKUTO_API_TOKEN=

# Which user token-less / token access acts as (default: the owner).
# PUROJEKUTO_USER_ID=

# Hide write tools from agents (read-only MCP).
# PUROJEKUTO_AGENT_READONLY=1

# ── AI specs ─────────────────────────────────────────────────────────────
# Default provider for new accounts: claude-code (the local `claude` CLI,
# already signed in), anthropic (needs ANTHROPIC_API_KEY) or none.
# PUROJEKUTO_AI_PROVIDER=claude-code
# PUROJEKUTO_AI_MODEL=opus
# PUROJEKUTO_CLAUDE_BIN=claude
# PUROJEKUTO_AI_TIMEOUT_MS=420000
# ANTHROPIC_API_KEY=
# Turn the background job runner off (e.g. a second instance on the same database).
# PUROJEKUTO_JOBS=0

# ── khal (calendar) ──────────────────────────────────────────────────────
# Working sessions and dated milestones go into a "Projects" calendar there.
# PUROJEKUTO_KHAL_URL=http://khal:3000
# PUROJEKUTO_KHAL_TOKEN=
# Where people open khal in a browser (links only).
# PUROJEKUTO_KHAL_PUBLIC_URL=https://khal.example.ts.net

# ── jinsen-ideas (ideas inbox) ───────────────────────────────────────────
# PUROJEKUTO_IDEAS_URL=http://jinsen-ideas:8011
# PUROJEKUTO_IDEAS_PUBLIC_URL=https://jinsen-ideas.example.ts.net
# PUROJEKUTO_IDEAS_OWNER=

# PUROJEKUTO_DB_PATH=./data/purojekuto.db
# PUROJEKUTO_PORT=3000
